{
  "name": "bille-celeste",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "level:validate": "tsx tools/level-validate.ts",
    "level:bot": "tsx tools/level-bot.ts",
    "level:gen": "tsx tools/level-gen.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "preact": "11.2.0",
    "three": "0.160.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.7",
    "@types/three": "0.160.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.9",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
